# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output (frontend/, lambda/*/, agent/, cdk/ — matches at any depth) ────
dist/
dist-bundle/
cdk.out/
cdk.out.before/
*.js.map
*.d.ts
*.tsbuildinfo
*.zip

# ── Scan tool output — regenerate locally, never commit ────────────────────────
gitleaks-results.json

# ── Environment / secrets — NEVER commit these ────────────────────────────────
.env
.env.local
.env.*.local

# ── Claude Code — personal settings only, not project config ──────────────────
.claude/settings.local.json
*.pem
*.key
*.p12
*.pfx

# ── CDK ────────────────────────────────────────────────────────────────────────
# cdk.context.json captures resolved account/region lookups — commit if you want
# reproducible deploys, but exclude if you don't want account info in git
cdk.context.json
# cdk-outputs.json is generated by deploy.sh — contains account IDs, never commit
cdk-outputs.json

# ── OS / editor noise ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Local notes — a personal working file, never committed ─────────────────────
todo.md

# ── Test / coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
